# Local development works without environment variables.
# Optional: use a separate data directory and fixed development ports.
# BUSYBOY_HOME=/absolute/path/to/busyboy-data
# BUSYBOY_PORT_OFFSET=0

# Optional: mobile app builds (apps/mobile).
# Apple team that signs iOS builds. Without it, Xcode picks the team.
# BUSYBOY_APPLE_TEAM_ID=ABC1234567
# Your Expo project for EAS builds and OTA updates. OTA updates stay off without it.
# BUSYBOY_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
# BUSYBOY_EAS_OWNER=your-expo-account
