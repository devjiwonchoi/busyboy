{
  "provider": "claude",
  "description": "Hand-written: a task that is still working, then finishes with State done and no pull requests, so BusyBoy archives it.",
  "turns": [
    {
      "prompt": "Publish the release checklist.",
      "steps": [
        {
          "writeFile": {
            "path": ".jwn/<cwd-name>/STATUS.md",
            "text": "# STATUS: release-checklist\n\n- Stage: Iterate\n- State: running\n\n| Todo | Result |\n| --- | --- |\n| 1 | running |\n"
          }
        },
        {
          "event": {
            "type": "text",
            "itemId": "checklist-working",
            "text": "The checklist is underway."
          }
        }
      ]
    },
    {
      "prompt": "Mark the release checklist done.",
      "context": "Publish the release checklist.",
      "steps": [
        {
          "writeFile": {
            "path": ".jwn/<cwd-name>/STATUS.md",
            "text": "# STATUS: release-checklist\n\n- Stage: Ship\n- State: done\n\n| Todo | Result |\n| --- | --- |\n| 1 | done |\n"
          }
        },
        {
          "event": {
            "type": "text",
            "itemId": "checklist-done",
            "text": "The checklist is done."
          }
        }
      ]
    }
  ]
}
