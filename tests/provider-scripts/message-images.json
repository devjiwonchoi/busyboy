{
  "provider": "claude",
  "description": "Hand-written: a slow reply to a message with an image, then on the retry a report of the image blocks the message carried.",
  "turns": [
    {
      "prompt": "Describe this image at length.",
      "steps": [
        { "event": { "type": "text-delta", "text": "This image shows" } },
        { "delayMs": 30000 },
        { "event": { "type": "text", "text": "The end of the description." } }
      ]
    },
    {
      "prompt": "Describe this image at length.",
      "context": "Describe this image at length.",
      "steps": [{ "echoAttachments": true }]
    }
  ]
}
