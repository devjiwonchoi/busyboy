{
  "provider": "claude",
  "description": "The Director reports the image blocks and file paths a composer message carried.",
  "turns": [
    {
      "prompt": "Look at this pasted image",
      "steps": [{ "echoAttachments": true }]
    },
    {
      "prompt": "Look at this dropped image",
      "steps": [{ "echoAttachments": true }]
    },
    {
      "prompt": "Look at this attached file",
      "steps": [{ "echoAttachments": true }]
    }
  ]
}
