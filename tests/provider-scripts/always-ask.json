{
  "provider": "claude",
  "description": "Hand-written: task agents that run actions on the always-ask list, and one that only deletes inside its own folder.",
  "turns": [
    {
      "prompt": "Force push the branch to origin.",
      "steps": [
        {
          "toolCall": {
            "name": "Bash",
            "input": {
              "command": "git push --force origin HEAD"
            }
          },
          "then": {
            "allow": [
              {
                "toolCall": {
                  "name": "Bash",
                  "input": {
                    "command": "git push --force origin HEAD"
                  }
                },
                "then": {
                  "allow": [
                    {
                      "toolCall": {
                        "name": "Bash",
                        "input": {
                          "command": "git push --force origin release"
                        }
                      },
                      "then": {
                        "allow": [
                          {
                            "event": {
                              "type": "text",
                              "itemId": "push-both",
                              "text": "Force pushed both branches."
                            }
                          }
                        ],
                        "deny": [
                          {
                            "event": {
                              "type": "text",
                              "itemId": "push-once",
                              "text": "Force pushed the branch only."
                            }
                          }
                        ]
                      }
                    }
                  ],
                  "deny": [
                    {
                      "event": {
                        "type": "text",
                        "itemId": "push-repeat-deny",
                        "text": "I did not force push again."
                      }
                    }
                  ]
                }
              }
            ],
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "push-deny",
                  "text": "I did not force push."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Run the release script.",
      "steps": [
        {
          "toolCall": {
            "name": "Bash",
            "input": {
              "command": "./release.sh --publish"
            }
          },
          "then": {
            "allow": [
              {
                "event": {
                  "type": "text",
                  "itemId": "release-allow",
                  "text": "Released."
                }
              }
            ],
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "release-deny",
                  "text": "I did not release."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Delete the notes file outside this task with a patch.",
      "steps": [
        {
          "toolCall": {
            "name": "Bash",
            "input": {
              "command": "apply_patch <<'EOF'\n*** Begin Patch\n*** Delete File: ../other-project/notes.txt\n*** End Patch\nEOF"
            }
          },
          "then": {
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "patch-delete-deny",
                  "text": "I did not delete the notes."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Update the footer, and mention the force push in the diff.",
      "steps": [
        {
          "toolCall": {
            "name": "Bash",
            "input": {
              "command": "apply_patch <<'EOF'\n*** Begin Patch\n*** Update File: src/app.ts\n@@\n-old\n+git push --force origin main\n*** End Patch\nEOF"
            }
          },
          "then": {
            "allow": [
              {
                "event": {
                  "type": "text",
                  "itemId": "patch-update",
                  "text": "Updated the footer."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Force push using the shell_command tool.",
      "steps": [
        {
          "toolCall": {
            "name": "shell_command",
            "input": {
              "cmd": "git push --force origin HEAD"
            }
          },
          "then": {
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "shell-command-deny",
                  "text": "I did not force push."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Force push, with the command passed as one argument.",
      "steps": [
        {
          "toolCall": {
            "name": "Bash",
            "input": {
              "command": ["git push --force origin feature"]
            }
          },
          "then": {
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "argv-deny",
                  "text": "I did not force push."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Remove the build folder.",
      "steps": [
        {
          "toolCall": {
            "name": "Bash",
            "input": {
              "command": "rm -rf dist"
            }
          },
          "then": {
            "allow": [
              {
                "event": {
                  "type": "text",
                  "itemId": "clean-allow",
                  "text": "Removed dist."
                }
              }
            ],
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "clean-deny",
                  "text": "I could not remove dist."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Force push the main branch yourself.",
      "steps": [
        {
          "toolCall": {
            "name": "Bash",
            "input": {
              "command": "git push --force origin main"
            }
          },
          "then": {
            "allow": [
              {
                "event": {
                  "type": "text",
                  "itemId": "director-push-allow",
                  "text": "Force pushed main."
                }
              }
            ],
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "director-push-deny",
                  "text": "I could not run that, so a task will have to do it."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Clear the task list file yourself.",
      "steps": [
        {
          "toolCall": {
            "name": "Write",
            "input": {
              "file_path": "../task-list.json",
              "content": "[]\n"
            }
          },
          "then": {
            "allow": [
              {
                "event": {
                  "type": "text",
                  "itemId": "director-task-list-allow",
                  "text": "Cleared the task list."
                }
              }
            ],
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "director-task-list-deny",
                  "text": "BusyBoy kept me out of its task list."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Show the settings file with a command.",
      "steps": [
        {
          "toolCall": {
            "name": "Bash",
            "input": {
              "command": "cat ../app-settings.json"
            }
          },
          "then": {
            "allow": [
              {
                "event": {
                  "type": "text",
                  "itemId": "director-settings-allow",
                  "text": "Here are the settings."
                }
              }
            ],
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "director-settings-deny",
                  "text": "BusyBoy kept me out of its settings."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Keep a note in your own folder.",
      "steps": [
        {
          "toolCall": {
            "name": "Write",
            "input": {
              "file_path": "notes.md",
              "content": "Remember the release.\n"
            }
          },
          "then": {
            "allow": [
              {
                "event": {
                  "type": "text",
                  "itemId": "director-note-allow",
                  "text": "Saved the note."
                }
              }
            ],
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "director-note-deny",
                  "text": "I could not save the note."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Download the CI screenshots into the task record.",
      "steps": [
        {
          "toolCall": {
            "name": "Bash",
            "input": {
              "command": "cd <cwd>; A=<record-folder>/ci-artifact; rm -rf $A; mkdir -p $A; gh run download 44170948268 -D $A 2>&1 | tail -2; find $A -name \"empty-composer*.png\""
            }
          },
          "then": {
            "allow": [
              {
                "event": {
                  "type": "text",
                  "itemId": "artifact-allow",
                  "text": "Downloaded the screenshots."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Delete a folder that is outside this task.",
      "steps": [
        {
          "toolCall": {
            "name": "Bash",
            "input": {
              "command": "rm -rf /tmp/busyboy-outside-task"
            }
          },
          "then": {
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "outside-deny",
                  "text": "I did not delete it."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Delete a folder named by a variable that points outside this task.",
      "steps": [
        {
          "toolCall": {
            "name": "Bash",
            "input": {
              "command": "A=/tmp/busyboy-outside-task; rm -rf $A"
            }
          },
          "then": {
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "outside-var-deny",
                  "text": "I did not delete it."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Save a screenshot in the scratch folder and then remove it.",
      "steps": [
        { "writeInstructions": "task-instructions.txt" },
        {
          "toolCall": {
            "name": "Bash",
            "input": {
              "command": "mkdir -p .busyboy-scratch && printf shot > .busyboy-scratch/shot.png && rm -f .busyboy-scratch/shot.png"
            }
          },
          "then": {
            "allow": [
              {
                "event": {
                  "type": "text",
                  "itemId": "scratch-allow",
                  "text": "Saved and removed the screenshot."
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
