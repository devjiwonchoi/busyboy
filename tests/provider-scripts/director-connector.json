{
  "provider": "claude",
  "description": "Hand-written: the Director posts through a connector and waits for the user.",
  "turns": [
    {
      "prompt": "Post a note in Slack.",
      "steps": [
        {
          "toolCall": {
            "name": "mcp__slack__post_message",
            "input": {
              "channel": "general",
              "text": "Ship it."
            }
          },
          "then": {
            "allow": [
              {
                "event": {
                  "type": "text",
                  "itemId": "slack-allow",
                  "text": "Posted to Slack."
                }
              }
            ],
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "slack-deny",
                  "text": "I did not post to Slack."
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Post another note in Slack.",
      "steps": [
        {
          "toolCall": {
            "name": "mcp__slack__post_message",
            "input": {
              "channel": "general",
              "text": "Hold on."
            }
          },
          "then": {
            "allow": [
              {
                "event": {
                  "type": "text",
                  "itemId": "slack-allow-2",
                  "text": "Posted the second note."
                }
              }
            ],
            "deny": [
              {
                "event": {
                  "type": "text",
                  "itemId": "slack-deny-2",
                  "text": "I did not post to Slack."
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
