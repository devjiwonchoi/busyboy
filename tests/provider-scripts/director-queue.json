{
  "provider": "claude",
  "description": "Hand-written: a short delayed Director reply, then the message that waited behind it.",
  "turns": [
    {
      "prompt": "Count to three slowly.",
      "steps": [
        {
          "event": {
            "type": "text-delta",
            "itemId": "count",
            "text": "One"
          }
        },
        {
          "delayMs": 4000
        },
        {
          "event": {
            "type": "text",
            "itemId": "count",
            "text": "One, two, three."
          }
        }
      ]
    },
    {
      "prompt": "Now say done.",
      "steps": [
        {
          "event": {
            "type": "text",
            "itemId": "done",
            "text": "Done."
          }
        }
      ]
    }
  ]
}
