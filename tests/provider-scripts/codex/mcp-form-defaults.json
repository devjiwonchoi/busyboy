                  "notify": { "type": "boolean", "title": "Notify the team", "default": true }
                },
                "required": []
              },
              "_meta": null
            }
          },
          "echoReply": true
        },
        { "raw": { "method": "turn/completed", "params": { "turn": { "id": "turn-1", "status": "completed", "error": null } } } }
      ]
    }
  ]
}
