{
  "provider": "codex",
  "description": "Hand-written: Codex questions in both tool shapes, and a bulleted reply that is not a question.",
  "turns": [
    {
      "prompt": "Ask which color, with each choice labeled.",
      "steps": [
        {
          "raw": {
            "method": "item/completed",
            "params": {
              "item": {
                "type": "agentMessage",
                "id": "color-labeled",
                "text": "Which color do you prefer?",
                "questions": [
                  {
                    "question": "Which color do you prefer?",
                    "header": "Color",
                    "options": [
                      { "label": "Red (Recommended)", "description": "A warm color" },
                      { "label": "Blue", "description": "A cool color" }
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "raw": {
            "method": "item/completed",
            "params": {
              "item": {
                "type": "agentMessage",
                "id": "color-labeled-done",
                "text": "You picked Red."
              }
            }
          }
        },
        {
          "raw": {
            "method": "turn/completed",
            "params": { "turn": { "id": "color-labeled-turn", "status": "completed", "error": null } }
          }
        }
      ]
    },
    {
      "prompt": "Ask which color, using a title and plain options.",
      "steps": [
        {
          "raw": {
            "id": "color-title",
            "method": "item/tool/requestUserInput",
            "params": {
              "questions": [
                {
                  "id": "color",
                  "header": "Color",
                  "title": "Which color do you prefer?",
                  "options": ["Red", "Blue"]
                }
              ]
            }
          }
        },
        {
          "raw": {
            "method": "item/completed",
            "params": {
              "item": {
                "type": "agentMessage",
                "id": "color-title-done",
                "text": "You picked Red."
              }
            }
          }
        },
        {
          "raw": {
            "method": "turn/completed",
            "params": { "turn": { "id": "color-title-turn", "status": "completed", "error": null } }
          }
        }
      ]
    },
    {
      "prompt": "Summarize what changed in a short list.",
      "steps": [
        {
          "raw": {
            "method": "item/completed",
            "params": {
              "item": {
                "type": "agentMessage",
                "id": "summary",
                "text": "What changed?\n- Fixed the footer\n- Added tests"
              }
            }
          }
        },
        {
          "raw": {
            "method": "turn/completed",
            "params": { "turn": { "id": "summary-turn", "status": "completed", "error": null } }
          }
        }
      ]
    }
  ]
}
