{
  "provider": "codex",
  "description": "Hand-written: a Codex task agent whose tool calls go through BusyBoy's rule hook.",
  "turns": [
    {
      "prompt": "Print the secret token with Codex.",
      "steps": [
        {
          "preToolUse": {
            "tool_name": "Bash",
            "tool_input": {
              "command": "echo secret-token"
            }
          },
          "then": {
            "allow": [
              {
                "raw": {
                  "method": "item/completed",
                  "params": {
                    "item": {
                      "type": "agentMessage",
                      "id": "token-allow",
                      "text": "Printed the token."
                    }
                  }
                }
              }
            ],
            "deny": [
              {
                "raw": {
                  "method": "item/completed",
                  "params": {
                    "item": {
                      "type": "agentMessage",
                      "id": "token-deny",
                      "text": "I did not print the token."
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    },
    {
      "prompt": "Say hello with Codex.",
      "steps": [
        {
          "preToolUse": {
            "tool_name": "Bash",
            "tool_input": {
              "command": "echo hello"
            }
          },
          "then": {
            "allow": [
              {
                "raw": {
                  "method": "item/completed",
                  "params": {
                    "item": {
                      "type": "agentMessage",
                      "id": "hello-allow",
                      "text": "Said hello."
                    }
                  }
                }
              }
            ],
            "deny": [
              {
                "raw": {
                  "method": "item/completed",
                  "params": {
                    "item": {
                      "type": "agentMessage",
                      "id": "hello-deny",
                      "text": "I did not say hello."
                    }
                  }
                }
              }
            ]
          }
        }
      ]
    }
  ]
}
