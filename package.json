{
  "name": "busyboy",
  "version": "0.0.0",
  "private": true,
  "description": "Run coding tasks across projects with your installed agent CLIs.",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/prepare-standalone.mts",
    "start": "node scripts/start-standalone.mts",
    "build:electron": "node scripts/build-electron.mts",
    "dev:desktop": "pnpm build:electron && electron .",
    "build:desktop": "node scripts/build-desktop.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:e2e": "playwright test --pass-with-no-tests",
    "drive": "node --experimental-strip-types scripts/drive.mts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "electron-updater": "6.8.9",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@11.10.0",
  "productName": "BusyBoy"
}
