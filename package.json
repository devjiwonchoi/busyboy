{
  "name": "busyboy",
  "version": "0.0.0",
  "private": true,
  "description": "Run coding tasks across projects with your installed agent CLIs.",
  "scripts": {
    "dev": "pnpm --filter @busyboy/web dev",
    "build": "pnpm --filter @busyboy/web build",
    "start": "pnpm --filter @busyboy/web start",
    "build:electron": "pnpm --filter @busyboy/native build",
    "dev:desktop": "pnpm --filter @busyboy/native dev",
    "build:desktop": "pnpm --filter @busyboy/native build:desktop",
    "typecheck": "pnpm --filter @busyboy/web --filter @busyboy/native typecheck",
    "lint": "oxlint && knip",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:e2e": "pnpm --filter @busyboy/web test:e2e"
  },
  "devDependencies": {
    "knip": "6.45.1",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0"
  },
  "packageManager": "pnpm@11.10.0"
}
