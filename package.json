{
  "name": "busyboy",
  "productName": "BusyBoy",
  "version": "0.0.0",
  "private": true,
  "description": "Run coding tasks across projects with your installed agent CLIs.",
  "main": "dist-electron/main.cjs",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node scripts/prepare-standalone.mts",
    "start": "node scripts/start-standalone.mts",
    "build:electron": "node scripts/build-electron.mts",
    "dev:desktop": "pnpm build:electron && electron .",
    "build:desktop": "node scripts/build-desktop.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@base-ui/react": "1.9.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "lucide-react": "1.72.0",
    "next": "16.4.6",
    "node-pty": "1.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.21.0",
    "streamdown": "2.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3"
  }
}
