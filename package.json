{
  "name": "busyboy",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-runner.ts dev",
    "dev:server": "node scripts/dev-runner.ts dev:server",
    "dev:web": "node scripts/dev-runner.ts dev:web",
    "dev:desktop": "node scripts/dev-runner.ts dev:desktop",
    "local-app:install": "node apps/desktop/scripts/local-app.mjs install",
    "dev:mobile": "vp run --filter @t3tools/mobile dev:client",
    "start": "vp run --filter t3 start",
    "start:desktop": "vp run --filter @t3tools/desktop start",
    "build:resource-monitor": "cargo build --locked --release --manifest-path native/resource-monitor/Cargo.toml",
    "typecheck": "vp run -r --concurrency-limit 2 typecheck",
    "test": "vp run -r test",
    "test:resource-monitor": "cargo test --locked --manifest-path native/resource-monitor/Cargo.toml",
    "lint:mobile": "node scripts/mobile-native-static-check.ts",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "clean": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/dist apps/*/dist-electron packages/*/dist .vite-plus apps/*/.vite-plus packages/*/.vite-plus",
    "prepare": "effect-tsgo patch",
    "build": "vp run --filter @t3tools/desktop build",
    "build:release": "node scripts/build-desktop-release.ts",
    "release": "gh workflow run release.yml --ref main"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:",
    "@types/node": "catalog:",
    "tsc-rs": "0.7.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": "^24.13.1"
  },
  "packageManager": "pnpm@11.10.0"
}
