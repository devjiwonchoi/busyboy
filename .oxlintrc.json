{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react", "nextjs", "import"],
  "categories": {
    "correctness": "error"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19.3.1"
    },
    "next": {
      "rootDir": "apps/web"
    }
  },
  "options": {
    "maxWarnings": 0
  },
  "rules": {
    "react/refs": "off",
    "react/set-state-in-effect": "off"
  },
  "overrides": [
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect"],
                "message": "Do not sync state in an effect; compute it during render, handle the event, reset with a key, or subscribe with useSyncExternalStore. External setup goes through useExternalSync from apps/web/hooks/use-external-sync.ts (https://react.dev/learn/you-might-not-need-an-effect)."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/web/hooks/use-external-sync.ts", "apps/web/components/ui/**"],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ]
}
